{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "postinstall": "prisma generate && node fix-prisma-imports.js",
    "postbuild": "next-sitemap",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "npx prisma migrate deploy && npx prisma db seed",
    "db:seed:css": "npx tsx prisma/seedCssTutorials.ts",
    "db:seed:html": "npx tsx prisma/seedHtmlTutorials.ts",
    "db:seed:dsa": "npx tsx prisma/seedDsaTutorials.ts",
    "db:seed:all": "npx tsx scripts/dbSeeds/seeds/seedAll.ts",
    "db:reset": "npx prisma migrate reset --force",
    "db:studio": "npx prisma studio",
    "docker:build": "docker build -t vibed-to-cracked .",
    "docker:run": "docker run -p 3000:3000 vibed-to-cracked",
    "deploy:setup": "cp .env.production.example .env.production",
    "deploy:up": "docker-compose up -d --build",
    "deploy:down": "docker-compose down",
    "deploy:logs": "docker-compose logs -f",
    "deploy:backup": "docker-compose exec db pg_dump -U postgres vibed_to_cracked > backup_$(date +%Y%m%d_%H%M%S).sql",
    "data:validate": "node scripts/validate-data.js",
    "data:migrate": "node scripts/migrate-data.js",
    "data:fix": "npm run data:migrate && npm run data:validate"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/mdx": "^16.1.6",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.13",
    "@types/nodemailer": "^7.0.10",
    "@webcontainer/api": "^1.6.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.1",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.574.0",
    "mailchecker": "^6.0.19",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.1",
    "openai": "^6.32.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "phaser": "^3.90.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^5.2.8",
    "react-is": "^19.2.4",
    "react-live": "^4.1.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.3.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "monaco-editor": "^0.55.1",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
