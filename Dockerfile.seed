FROM node:25.9-alpine3.22
WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY fix-prisma-imports.js ./

RUN npm ci --legacy-peer-deps --ignore-scripts
RUN DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" npx prisma generate && node fix-prisma-imports.js

COPY scripts ./scripts
COPY src/content/tutorials ./src/content/tutorials

ENTRYPOINT ["npx", "tsx"]
